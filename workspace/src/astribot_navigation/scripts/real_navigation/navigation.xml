<!-- Only the full route can hand off to FinalNudge at the requested goal. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <FinalApproach goal="{goal}" distance="0.50" route="{path}" route_kind="{route_kind}" final_path="{final_path}">
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback>
          <PipelineSequence>
            <RateController hz="1.0">
              <Fallback>
                <Sequence>
                  <Fallback>
                    <BlackboardCheckString value_A="{route_kind}" value_B="full" return_on_mismatch="FAILURE">
                      <IsPathValid path="{path}"/>
                    </BlackboardCheckString>
                    <Sequence>
                      <ComputePathToPose goal="{goal}" path="{candidate}" planner_id="GridBased"/>
                      <IsPathValid path="{candidate}"/>
                      <SetBlackboard output_key="path" value="{candidate}"/>
                    </Sequence>
                  </Fallback>
                  <SetBlackboard output_key="route_kind" value="full"/>
                </Sequence>
                <Sequence>
                  <ComputePathToPose goal="{goal}" path="{approach_path}" planner_id="Approach"/>
                  <!-- Keep the progress check; a partial route does not require a preliminary turn. -->
                  <PrepareApproachTurn path="{approach_path}" goal="{goal}" turn="{next_turn}"/>
                  <SetBlackboard output_key="route_kind" value="partial"/>
                </Sequence>
              </Fallback>
            </RateController>
            <Switch2 variable="{route_kind}" case_1="full" case_2="partial">
              <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
              <ForceFailure>
                <FollowPath path="{approach_path}" controller_id="FollowPath" goal_checker_id="approach_position"/>
              </ForceFailure>
              <AlwaysFailure/>
            </Switch2>
          </PipelineSequence>
          <Sequence>
            <!-- The next controller instance must receive a path starting at the current pose. -->
            <SetBlackboard output_key="route_kind" value="replan"/>
            <Delay delay_msec="2000"><AlwaysFailure/></Delay>
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback>
          <FollowPath path="{final_path}" controller_id="FinalNudge" goal_checker_id="goal_checker"/>
          <Delay delay_msec="2000"><AlwaysFailure/></Delay>
        </Fallback>
      </RetryUntilSuccessful>
    </FinalApproach>
  </BehaviorTree>
</root>
